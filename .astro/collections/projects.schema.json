{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "type": "number"
    },
    "featured": {
      "default": true,
      "type": "boolean"
    },
    "accent": {
      "default": "sky",
      "type": "string",
      "enum": [
        "sky",
        "emerald",
        "violet",
        "amber",
        "orange"
      ]
    },
    "links": {
      "default": {},
      "type": "object",
      "properties": {
        "live": {
          "type": "string",
          "format": "uri"
        },
        "repo": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "image": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "imageWidth": {
      "type": "number"
    },
    "imageHeight": {
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "tagline",
    "year",
    "context",
    "stack",
    "order"
  ]
}