---
import { site } from '../data/site';
---

<div class="flex flex-col items-start gap-5">
  <p class="max-w-xl text-muted">
    If my experience looks like a fit, I'd like to hear about the role. Email is the fastest way
    to reach me.
  </p>
  <a
    href={`mailto:${site.email}`}
    class="text-xl font-semibold text-accent transition-colors hover:text-accent-soft md:text-2xl"
    >{site.email}</a
  >
  <p class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
    {
      site.resume.available && (
        <a href={site.resume.path} class="text-muted transition-colors hover:text-ink">
          {site.resume.label}
        </a>
      )
    }
    <a href={site.github} class="text-muted transition-colors hover:text-ink">GitHub ↗</a>
    <a href={site.linkedin} class="text-muted transition-colors hover:text-ink">LinkedIn ↗</a>
  </p>
</div>
