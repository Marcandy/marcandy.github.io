---
import { skills } from '../data/site';
---

<div class="grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
  {
    skills.map((group) => (
      <div>
        <h3 class="font-mono text-sm text-muted">{group.group}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded border border-line bg-surface px-2.5 py-1 text-sm">{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
