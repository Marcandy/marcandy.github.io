---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-20 px-6 py-14 md:py-20">
  <div class="mb-3 h-1 w-8 rounded-full bg-linear-to-r from-sky-400 to-violet-400" aria-hidden="true">
  </div>
  <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{title}</h2>
  <div class="mt-8">
    <slot />
  </div>
</section>
