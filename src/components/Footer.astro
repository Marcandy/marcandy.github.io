---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-6 py-8 text-sm text-muted"
  >
    <p>© {year} {site.name}</p>
    <a href={site.repo} class="transition-colors hover:text-ink">View source ↗</a>
  </div>
</footer>
