---
import { site } from '../data/site';
---

<header class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-6">
  <a
    href="/"
    class="font-semibold tracking-tight transition-colors hover:text-accent"
    >{site.name}</a
  >
  <nav aria-label="Primary">
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <li>
        <a class="inline-block py-2 text-muted transition-colors hover:text-ink" href="/#projects">Projects</a>
      </li>
      <li>
        <a class="inline-block py-2 text-muted transition-colors hover:text-ink" href="/#experience">Experience</a>
      </li>
      <li>
        <a class="inline-block py-2 text-muted transition-colors hover:text-ink" href="/#about">About</a>
      </li>
      <li>
        <a class="inline-block py-2 text-muted transition-colors hover:text-ink" href="/#contact">Contact</a>
      </li>
      {
        site.resume.available && (
          <li>
            <a
              class="rounded border border-line px-3 py-1.5 transition-colors hover:border-accent hover:text-accent"
              href={site.resume.path}
            >
              Resume
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>
