---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** The first (flagship) card spans the full grid width. */
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, tagline, year, context, stack, links } = project.data;
const href = `/projects/${project.id}/`;
---

<article
  class:list={[
    'flex flex-col gap-4 rounded-lg border border-line bg-surface p-6',
    featured && 'md:col-span-2',
  ]}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-semibold">
      <a href={href} class="transition-colors hover:text-accent">{title}</a>
    </h3>
    <p class="font-mono text-xs text-muted">{year} · {context}</p>
  </div>
  <p class="max-w-2xl text-muted">{tagline}</p>
  <ul class="flex flex-wrap gap-2" aria-label={`Tech stack for ${title}`}>
    {
      stack.map((item) => (
        <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">
          {item}
        </li>
      ))
    }
  </ul>
  <p class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-1 text-sm font-medium">
    <a href={href} class="inline-block py-1 text-accent transition-colors hover:text-accent-soft">
      Case study<span class="sr-only"> — {title}</span>
      <span aria-hidden="true">→</span>
    </a>
    {
      links.live && (
        <a href={links.live} class="inline-block py-1 text-muted transition-colors hover:text-ink">
          Live demo<span class="sr-only"> — {title}</span> ↗
        </a>
      )
    }
    {
      links.repo && (
        <a href={links.repo} class="inline-block py-1 text-muted transition-colors hover:text-ink">
          Code<span class="sr-only"> — {title}</span> ↗
        </a>
      )
    }
  </p>
</article>
