---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Base title={`Page not found · ${site.name}`} description="That page doesn't exist.">
  <Header />
  <main id="main" class="mx-auto flex max-w-5xl flex-col items-start gap-4 px-6 py-24">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="text-3xl font-bold tracking-tight">There's nothing at this address.</h1>
    <p class="text-muted">The page may have moved when this site was rebuilt.</p>
    <a
      href="/"
      class="mt-2 rounded bg-accent px-4 py-2 font-medium text-canvas transition-colors hover:bg-accent-soft"
      >Back to the homepage</a
    >
  </main>
  <Footer />
</Base>
